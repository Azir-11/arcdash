{
  "name": "arcdash",
  "type": "module",
  "version": "0.0.55",
  "private": false,
  "description": "Business Function Library - Modern, Simple, Typed, and Powerful",
  "author": "azir-11",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/Azir-11/arcdash"
  },
  "keywords": [
    "arcdash"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "vitest",
    "build": "pnpm tsc --noEmit && tsdown && mv cdn/arcdash.iife.js cdn/arcdash.js && mv cdn/arcdash.iife.min.js cdn/arcdash.min.js",
    "dev": "vitepress dev docs",
    "docs:gen": "func2md --src-dir=src --out-dir=docs/api",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "cleanup": "soy cleanup",
    "commit": "soy git-commit -l=zh-cn",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "release": "soy release",
    "update-pkg": "soy update-pkg"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.1.0",
    "@types/node": "^22.5.4",
    "func2md": "^0.1.1",
    "npm-check-updates": "^17.1.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.4",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-plugin-llms": "^1.12.2",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "defu": "6.1.7",
    "klona": "2.0.6"
  }
}
